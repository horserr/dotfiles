# ~/.bashrc: executed by bash(1) for non-login shells.
# see /usr/share/doc/bash/examples/startup-files (in the package bash-doc)
# for examples

# If not running interactively, don't do anything
case $- in
*i*) ;;
*) return ;;
esac

BASHROOT=~/.config/bash

# load order: behavior -> environment -> PATH -> completion -> prompt -> aliases/functions
source "$BASHROOT/options.sh"
source "$BASHROOT/env.sh"
source "$BASHROOT/path.sh"
source "$BASHROOT/completion.sh"
source "$BASHROOT/prompt.sh"
source "$BASHROOT/alias.sh"
source "$BASHROOT/functions.sh"
source "$BASHROOT/chezmoi.sh"

# platform-specific snippets
if [ "$OS" = "Windows_NT" ]; then
	source "$BASHROOT/windows.sh"
fi
