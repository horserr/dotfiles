{
  "bindAddress": "127.0.0.1",
  "port": 18765,

  // mapping:
  // haiku, claude-haiku-*	gpt-6-luna
  // sonnet, claude-sonnet-*	gpt-5.6-terra
  // opus, fable, claude-opus-*, claude-fable-*	gpt-6-sol
  "aliasProvider": "codex",

  "codex": {
    "originator": "claude-code-proxy",
    "userAgent": "claude-code-proxy/0.1.24",
    "baseUrl": "https://chatgpt.com/backend-api/codex/responses",
    "transport": "auto",
    "headerTimeoutMs": 300000,
    "previousResponseId": false,
    "serverCompaction": false,
    "responsesApi": false,
    "fullLane": false,
    "imagesApi": false,
    "imagesBaseUrl": "https://chatgpt.com/backend-api/codex"
  },
  "log": {
    "stderr": false,
    "verbose": false
  }
}
