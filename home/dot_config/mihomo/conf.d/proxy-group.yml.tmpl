# 手动选择
type-select: &type-select
  type: select
  url: "https://www.gstatic.com/generate_204"

# 自动测速（延迟最低）
type-urltest: &type-urltest
  type: url-test
  url: "https://www.gstatic.com/generate_204"
  interval: 300
  lazy: true
  tolerance: 50
  timeout: 2000
  max-failed-times: 3 # 连续失败 3 次触发重新检查
  hidden: true # 在面板中隐藏（减少界面噪音）

# 自动回退（当前节点失败就切下一个）
type-fallback: &type-fallback
  type: fallback
  url: "https://www.gstatic.com/generate_204"
  interval: 300
  lazy: true
  timeout: 2000
  max-failed-times: 3
  hidden: true

# 负载均衡（一致性散列）
type-balance: &type-balance
  type: load-balance
  strategy: consistent-hashing # round-robin / consistent-hashing / sticky-sessions
  url: "https://www.gstatic.com/generate_204"
  interval: 300
  lazy: true
  timeout: 2000
  hidden: true

type-smart: &type-smart
  type: smart
  interval: 200
  lazy: true
  url: "https://www.google.com/generate_204"
  hidden: true
  uselightgbm: true # 启用 LightGBM 模型（需要 mihomo 支持该特性）

FilterINFO: &FilterINFO
  filter: "^.*(回国|校园|剩余|到期|官网|客服|订阅|节点|过期).*$"

FilterHK: &FilterHK
  filter: "^(?=.*(🇭🇰|港|HK|Hong Kong|香港))(?!.*(回国|校园|剩余|到期|官网|客服|订阅|节点|过期)).*$"
FilterTW: &FilterTW
  filter: "^(?=.*(🇹🇼|台|TW|Taiwan|台湾))(?!.*(回国|校园|剩余|到期|官网|客服|订阅|节点|过期)).*$"
FilterJP: &FilterJP
  filter: "^(?=.*(🇯🇵|日|JP|Japan|Tokyo|Osaka|日本))(?!.*(回国|校园|剩余|到期|官网|客服|订阅|节点|过期)).*$"
FilterSG: &FilterSG
  filter: "^(?=.*(🇸🇬|新|SG|Singapore|新加坡))(?!.*(回国|校园|剩余|到期|官网|客服|订阅|节点|过期)).*$"
FilterUS: &FilterUS
  filter: "^(?=.*(🇺🇸|美|US|United States|美国))(?!.*(回国|校园|剩余|到期|官网|客服|订阅|节点|过期)).*$"
FilterKR: &FilterKR
  filter: "^(?=.*(🇰🇷|韩|KR|Korea|韩国))(?!.*(回国|校园|剩余|到期|官网|客服|订阅|节点|过期)).*$"
FilterUK: &FilterUK
  filter: "^(?=.*(🇬🇧|英|GB|UK|United Kindom|London|英国|伦敦))(?!.*(回国|校园|剩余|到期|官网|客服|订阅|节点|过期)).*$"

Filter1: &Filter1
  filter: "^.*1x.*$"
Filter0-5: &Filter0-5
  filter: "^.*0.5x.*$"
Filter0-1: &Filter0-1
  filter: "^.*0.1x.*$"
Filter0-01: &Filter0-01
  filter: "^.*0.01x.*$"

FilterStream: &FilterStream
  filter: "(?i)^.*(stream|流媒体).*$"

FilterHysteria: &FilterHysteria
  filter: "hysteria2"
FilterVless: &FilterVless
  filter: "vless"

XFilterHK: &XFilterHK
  filter: "^(?!.*(🇭🇰|港|HK|Hong Kong|香港))(?!.*(回国|校园|剩余|到期|官网|客服|订阅|节点|过期)).*$"

proxy-groups:
  - name: "🎯 PROXY"
    <<: *type-select
    proxies:
      - "🇭🇰 HK"
      - "🇸🇬 SG"
      - "🇯🇵 JP"
      - "🇺🇸 US"
      - "🇰🇷 KR"
      - "🇹🇼 TW"
      - "🇬🇧 UK"
      - "🤪 HYSTERIA"
      - "⬇️ DOWNLOAD"
      - DIRECT
    default-selected: {{ ternary "🤪 HYSTERIA" "DIRECT" .needMirror }}

  - name: "🤖 AI"
    <<: [*type-select, *XFilterHK]
    include-all: true

  - name: "🛡️ AD"
    type: select
    proxies: [REJECT, DIRECT]
    default-selected: REJECT

  - name: "📹 STREAM"
    <<: [*type-select, *FilterStream]
    proxies: ["DIRECT"]
    include-all: true
    default-selected: DIRECT

  - name: "✈️ TELEGRAM"
    type: select
    proxies: ["🇸🇬 SG", "🇭🇰 HK", DIRECT]
    default-selected: DIRECT

  - name: "Ⓜ️ MICROSOFT"
    type: select
    proxies: [DIRECT]

  - name: "🤪 HYSTERIA"
    <<: [*type-select, *FilterHysteria]
    include-all: true

  - name: "⬇️ DOWNLOAD"
    <<: *type-select
    proxies: ["0.01", "🤪 HYSTERIA", DIRECT, "0.1", "0.5", "1"]
    default-selected: "0.01"

  - name: "1"
    <<: [*type-select, *Filter1]
    include-all: true
    hidden: false
  - name: "0.5"
    <<: [*type-select, *Filter0-5]
    include-all: true
    hidden: false
  - name: "0.1"
    <<: [*type-select, *Filter0-1]
    include-all: true
    hidden: false
  - name: "0.01"
    <<: [*type-select, *Filter0-01]
    include-all: true
    hidden: false

  # 地区三合一
  - name: "🇭🇰 HK"
    type: select
    proxies: ["🇭🇰 HK-自动", "🇭🇰 HK-回退", "🇭🇰 HK-均衡"]
  - name: "🇸🇬 SG"
    type: select
    proxies: ["🇸🇬 SG-自动", "🇸🇬 SG-回退", "🇸🇬 SG-均衡"]
  - name: "🇯🇵 JP"
    type: select
    proxies: ["🇯🇵 JP-自动", "🇯🇵 JP-回退", "🇯🇵 JP-均衡"]
  - name: "🇺🇸 US"
    type: select
    proxies: ["🇺🇸 US-自动", "🇺🇸 US-回退", "🇺🇸 US-均衡"]
  - name: "🇰🇷 KR"
    type: select
    proxies: ["🇰🇷 KR-自动", "🇰🇷 KR-回退", "🇰🇷 KR-均衡"]
  - name: "🇹🇼 TW"
    type: select
    proxies: ["🇹🇼 TW-自动", "🇹🇼 TW-回退", "🇹🇼 TW-均衡"]
  - name: "🇬🇧 UK"
    type: select
    proxies: ["🇬🇧 UK-自动", "🇬🇧 UK-回退", "🇬🇧 UK-均衡"]

  - { name: "🇭🇰 HK-回退", <<: [*type-fallback, *FilterHK], include-all: true }
  - { name: "🇭🇰 HK-均衡", <<: [*type-balance, *FilterHK], include-all: true }
  - { name: "🇭🇰 HK-自动", <<: [*type-urltest, *FilterHK], include-all: true }

  - { name: "🇯🇵 JP-回退", <<: [*type-fallback, *FilterJP], include-all: true }
  - { name: "🇯🇵 JP-均衡", <<: [*type-balance, *FilterJP], include-all: true }
  - { name: "🇯🇵 JP-自动", <<: [*type-urltest, *FilterJP], include-all: true }

  - { name: "🇰🇷 KR-回退", <<: [*type-fallback, *FilterKR], include-all: true }
  - { name: "🇰🇷 KR-均衡", <<: [*type-balance, *FilterKR], include-all: true }
  - { name: "🇰🇷 KR-自动", <<: [*type-urltest, *FilterKR], include-all: true }

  - { name: "🇸🇬 SG-回退", <<: [*type-fallback, *FilterSG], include-all: true }
  - { name: "🇸🇬 SG-均衡", <<: [*type-balance, *FilterSG], include-all: true }
  - { name: "🇸🇬 SG-自动", <<: [*type-urltest, *FilterSG], include-all: true }

  - { name: "🇹🇼 TW-回退", <<: [*type-fallback, *FilterTW], include-all: true }
  - { name: "🇹🇼 TW-均衡", <<: [*type-balance, *FilterTW], include-all: true }
  - { name: "🇹🇼 TW-自动", <<: [*type-urltest, *FilterTW], include-all: true }

  - { name: "🇺🇸 US-回退", <<: [*type-fallback, *FilterUS], include-all: true }
  - { name: "🇺🇸 US-均衡", <<: [*type-balance, *FilterUS], include-all: true }
  - { name: "🇺🇸 US-自动", <<: [*type-urltest, *FilterUS], include-all: true }

  - { name: "🇬🇧 UK-回退", <<: [*type-fallback, *FilterUK], include-all: true }
  - { name: "🇬🇧 UK-均衡", <<: [*type-balance, *FilterUK], include-all: true }
  - { name: "🇬🇧 UK-自动", <<: [*type-urltest, *FilterUK], include-all: true }

  - name: "🐟 MATCH"
    type: select
    proxies: [DIRECT, "🎯 PROXY"]
    default-selected: {{ ternary "🎯 PROXY" "DIRECT" .needMirror }}

  # - name: "ℹ️ INFO"
  #   # <<: [*type-fallback, *FilterINFO]
  #   <<: [*type-select, *FilterINFO]
  #   include-all: true

  - name: "🃏 ALL"
    <<: *type-select
    include-all: true
