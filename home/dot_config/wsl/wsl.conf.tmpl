# link: https://learn.microsoft.com/en-us/windows/wsl/wsl-config#configuration-settings-for-wslconfig

{{ $mirrored := false }}
{{ $gui := false }}
{{ $dnstunnel := true }}

[wsl2]
  {{ if $mirrored }}
    networkingMode=mirrored
    autoProxy=true
  {{ else }}
    networkingMode=nat
    autoProxy=false
    localhostForwarding=true
    dnsProxy=true
  {{ end }}

  memory=9GB
  processors=9
  swap=12GB

  defaultVhdSize=128GB

  #**********************
  #* DEFAULT SETTINGS *
  #**********************
  guiApplications={{$gui}}

  safeMode=false

  debugConsole=false

  nestedVirtualization=true

  firewall=true

  dnsTunneling={{ $dnstunnel }}

[experimental]
  {{ if $mirrored }}
  # when networkingMode is mirrored
  hostAddressLoopback=true
  {{ end }}

  autoMemoryReclaim=gradual
  sparseVhd=true

  {{ if $dnstunnel }}
  bestEffortDnsParsing=true
  {{ end }}
