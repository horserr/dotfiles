[
  /**********************
   * FILE EXPLORER VIEW *
   **********************/
  {
    "key": "escape",
    "command": "filesExplorer.cancelCut",
    "when": "explorerResourceCut && filesExplorerFocus && foldersViewVisible && !inputFocus"
  },
  {
    "key": "v",
    "command": "whichkey.show",
    "args": [
      {
        "key": " ",
        "name": "+View Common",
        "icon": "x",
        "type": "command",
        "command": "runCommands",
        "args": {
          "commands": [
            "whichkey.show",
            { "command": "whichkey.triggerKey", "args": "v" }
          ]
        }
      },
      // s find in folder
      {
        "key": "s",
        "name": "find in folder",
        "icon": "zap",
        "type": "command",
        "command": "search.action.restrictSearchToFolder"
      },
      // S find in workspace
      {
        "key": "S",
        "name": "find in workspace",
        "icon": "zap",
        "type": "command",
        "command": "filesExplorer.findInWorkspace"
      },
      // a new file
      {
        "key": "a",
        "name": "new file",
        "icon": "zap",
        "type": "command",
        "command": "explorer.newFile"
      },
      // g download file
      {
        "key": "g",
        "name": "download/get file",
        "icon": "download",
        "type": "command",
        "command": "explorer.download"
      },
      // d delete file
      {
        "key": "d",
        "name": "delete file",
        "icon": "zap",
        "type": "command",
        "command": "deleteFile"
      },
      // x cut file
      {
        "key": "x",
        "name": "cut file",
        "icon": "zap",
        "type": "command",
        "command": "filesExplorer.cut"
      },
      // r rename file
      {
        "key": "r",
        "name": "rename file",
        "icon": "zap",
        "type": "command",
        "command": "renameFile"
      },
      // v reveal in file os
      {
        "key": "v",
        "name": "reveal in file os",
        "icon": "zap",
        "type": "command",
        "command": "revealFileInOS"
      },
      // y copy file
      {
        "key": "y",
        "name": "copy file",
        "icon": "zap",
        "type": "command",
        "command": "filesExplorer.copy"
      },
      // p paste file
      {
        "key": "p",
        "name": "paste file",
        "icon": "zap",
        "type": "command",
        "command": "filesExplorer.paste"
      }
    ],
    // "when": "filesExplorerFocus && !inputFocus"
    // "when": "(activeViewlet == 'workbench.view.explorer' || activePanel == 'workbench.view.explorer' || activeAuxiliary == 'workbench.view.explorer') && !inputFocus"
    "when": "focusedView == 'workbench.explorer.fileView' && !inputFocus"
  }
]
