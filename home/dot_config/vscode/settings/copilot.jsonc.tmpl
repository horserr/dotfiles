{
  "inlineChat.defaultModel": "DeepSeek V4.1 Flash (deepseek)",

  "chat.defaultConfiguration": {
    "mode": "interactive",
    "approvals": "assisted"
  },
  "chat.defaultToCopilotHarness": false,
  "chat.editor.preferCopilotHarness": false,


  "chat.agent.maxRequests": 200,
  "chat.agent.thinking.collapsedTools": "withThinking",
  // default to use deepseek
  "chat.defaultModel": "Deepseek V4.1 Flash",
  "chat.disableAIFeatures": false,
  // copilot chat settings
  "chat.editor.lineHeight": 1.4,
  "chat.editor.wordWrap": "on",
  "chat.edits2.enabled": true,
  "chat.fontFamily": "LXGW Wenkai",
  "chat.notifyWindowOnConfirmation": "windowNotFocused",
  "chat.notifyWindowOnResponseReceived": "windowNotFocused",
  "chat.renderRelatedFiles": true,
  "chat.tools.terminal.sandbox.enabled": false,
  "chat.viewProgressBadge.enabled": true,
  "chat.viewSessions.orientation": "stacked",
  "github.copilot.enable": {
    "*": false,
    "markdown": false,
    "plaintext": false,
    "scminput": true
  },
  "github.copilot.advanced": {
    "debug.overrideCAPIUrl": "https://deepseek.com",
    "debug.chatOverrideProxyUrl": "https://deepseek.com/chat/completions"
  },

  "chat.fontSize": {{ .vscode.fontSize.major }},
  "chat.editor.fontSize": {{ .vscode.fontSize.major }}
}
