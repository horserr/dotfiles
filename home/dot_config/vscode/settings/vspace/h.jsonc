[
  // no effect "workbench.action.url.openUrl",
  {
    "key": "h",
    "name": "+Help",
    "icon": "question",
    "type": "bindings",
    "bindings": [
      // space custom commands
      {
        "key": " ",
        "name": "open custom commands",
        "type": "command",
        "command": "commands.openAsQuickPick"
      },
      // h help
      {
        "key": "h",
        "name": "+Help",
        "type": "bindings",
        "bindings": [
          {
            "key": "c",
            "name": "show aviliable commands",
            "type": "command",
            "command": "commands.suggestCommands"
          },
          {
            "key": "s",
            "name": "show settings",
            "type": "command",
            "command": "commands.suggestSettings"
          },
          {
            "key": "v",
            "name": "show variables",
            "type": "command",
            "command": "commands.suggestVariables"
          },
          {
            "key": "i",
            "name": "show icons",
            "type": "command",
            "command": "commands.suggestCodicons"
          },
          {
            "key": "C",
            "name": "show colors",
            "type": "command",
            "command": "commands.suggestColors"
          },
          {
            "key": "p",
            "name": "show color picker",
            "type": "command",
            "command": "editor.action.showOrFocusStandaloneColorPicker"
          },
          {
            "key": "l",
            "name": "show languages",
            "type": "command",
            "command": "workbench.action.configureLanguageBasedSettings"
          }
        ]
      },
      // l online
      {
        "key": "l",
        "name": "+Online",
        "icon": "keyboard",
        "type": "bindings",
        "bindings": [
          {
            "key": " ",
            "name": "search in browser bookmard",
            "icon": "book",
            "type": "command",
            "command": "browser-bookmark.search"
          },
          // l code search
          {
            "key": "l",
            "name": "+Code search",
            "icon": "search",
            "type": "bindings",
            "bindings": [
              {
                "key": "g",
                "name": "github search",
                "icon": "github-alt",
                "type": "command",
                "command": "vscode.open",
                "args": "https://github.com/search"
              },
              // source graph search
              {
                "key": "s",
                "name": "source graph code search",
                "icon": "skip",
                "type": "command",
                "command": "vscode.open",
                "args": "https://sourcegraph.com/search"
              }
            ]
          },
          // f feature request
          {
            "key": "f",
            "name": "Open feature request",
            "icon": "keyboard",
            "type": "command",
            "command": "workbench.action.openRequestFeatureUrl"
          },
          // r open regex101
          {
            "key": "r",
            "name": "Open regex101",
            "icon": "book",
            "type": "command",
            "command": "vscode.open",
            "args": "https://regex101.com/"
          },
          // s snippet generator
          {
            "key": "s",
            "name": "Open snippet generator",
            "icon": "book",
            "type": "command",
            "command": "vscode.open",
            "args": "https://snippet-generator.app/?description=&tabtrigger=&snippet=&mode=vscode"
          }
        ]
      },
      // t +trust
      {
        "key": "t",
        "name": "+Trust",
        "icon": "extension-workspace-trust",
        "type": "bindings",
        "bindings": [
          // w wordspace trust
          {
            "key": "w",
            "name": "Configure workspace trust",
            "icon": "workspace-trusted",
            "type": "command",
            "command": "workbench.trust.manage"
          },
          // r unsafe repository
          {
            "key": "r",
            "name": "mange unsafe repository",
            "icon": "workspace-trusted",
            "type": "command",
            "command": "git.manageUnsafeRepositories"
          },
          // d domain trust
          {
            "key": "d",
            "name": "Configure domain trust",
            "icon": "search-show-replace",
            "type": "command",
            "command": "workbench.action.manageTrustedDomain"
          }
        ]
      },
      // s setting
      {
        "key": "s",
        "name": "+Settings",
        "icon": "settings",
        "type": "bindings",
        "bindings": [
          // , all settings
          {
            "key": ",",
            "name": "display all settings",
            "icon": "keyboard",
            "type": "command",
            "command": "blitz.editSetting"
          },
          // space default json setting
          {
            "key": " ",
            "name": "Open system(default) settings json",
            "icon": "keyboard",
            "type": "command",
            "command": "workbench.action.openRawDefaultSettings"
          },
          // s user json setting
          {
            "key": "s",
            "name": "Open user json settings",
            "icon": "keyboard",
            "type": "conditional",
            "bindings": [
              {
                "key": "when:remoteName",
                "name": "Open remote settings",
                "icon": "keyboard",
                "type": "command",
                "command": "workbench.action.openRemoteSettingsFile"
              },
              {
                "key": "",
                "name": "Open user json settings",
                "icon": "keyboard",
                "type": "command",
                "command": "workbench.action.openSettingsJson"
              }
            ]
          },
          // user ui setting
          {
            "key": "U",
            "name": "Open user settings (UI)",
            "icon": "settings",
            "type": "command",
            "command": "workbench.action.openGlobalSettings"
          },
          // w workspace setting
          {
            "key": "w",
            "name": "Open workspace settings",
            "icon": "keyboard",
            "type": "command",
            "command": "workbench.action.openWorkspaceSettingsFile"
          }
        ]
      },
      // k keybinding
      {
        "key": "k",
        "name": "+Keybindings",
        "icon": "keybindings-record-keys",
        "type": "bindings",
        "bindings": [
          // space default keybindings
          {
            "key": " ",
            "name": "Open default key bindings JSON",
            "icon": "json",
            "type": "command",
            "command": "workbench.action.openDefaultKeybindingsFile"
          },
          // e keybinding editor
          {
            "key": "e",
            "name": "Open key bindings editor",
            "icon": "keyboard",
            "type": "command",
            "command": "workbench.action.openGlobalKeybindings"
          },
          // k user keybindings
          {
            "key": "k",
            "name": "Open user key bindings JSON",
            "icon": "json",
            "type": "command",
            "command": "workbench.action.openGlobalKeybindingsFile"
          },
          // r default keybinding reference
          {
            "key": "r",
            "name": "Open default key bindings reference(pdf)",
            "icon": "defaultProfile-icon",
            "type": "command",
            "command": "workbench.action.keybindingsReference"
          }
        ]
      },
      // d doc
      {
        "key": "d",
        "name": "+Doc/Manual",
        "icon": "book",
        "type": "bindings",
        "bindings": [
          {
            "key": "v",
            "name": "Open VSCode variables for debug and tasks Documentation",
            "icon": "book",
            "type": "command",
            "command": "vscode.open",
            "args": "https://code.visualstudio.com/docs/reference/variables-reference"
          },
          {
            "key": "s",
            "name": "Open VSCode snippet variable Documentation",
            "icon": "symbol-snippet",
            "type": "command",
            "command": "vscode.open",
            "args": "https://code.visualstudio.com/docs/editing/userdefinedsnippets#_variables"
          },
          {
            "key": "S",
            "name": "Open VSCode snippet grammar Documentation",
            "icon": "symbol-snippet",
            "type": "command",
            "command": "vscode.open",
            "args": "https://code.visualstudio.com/docs/editing/userdefinedsnippets#_grammar"
          },
          {
            "key": "w",
            "name": "Open vscode when clause Documentation",
            "icon": "book",
            "type": "command",
            "command": "vscode.open",
            "args": "https://code.visualstudio.com/api/references/when-clause-contexts#available-context-keys"
          },
          {
            "key": "c",
            "name": "Open vscode built-in commands Documentation",
            "icon": "book",
            "type": "command",
            "command": "vscode.open",
            "args": "https://code.visualstudio.com/api/references/commands#commands"
          },
          // s json schema
          {
            "key": "s",
            "name": "Open vscode json schemas",
            "icon": "getting-started-step-checked",
            "type": "command",
            "command": "vscode.open",
            "args": "https://github.com/wraith13/vscode-schemas"
          },
          // t vscode tasks
          {
            "key": "t",
            "name": "Open vscode tasks document",
            "icon": "getting-started-step-checked",
            "type": "command",
            "command": "vscode.open",
            "args": "https://code.visualstudio.com/docs/debugtest/tasks#_custom-tasks"
          },
          {
            "key": "T",
            "name": "Open vscode vscode tasks json schema document",
            "icon": "getting-started-step-checked",
            "type": "command",
            "command": "vscode.open",
            "args": "https://code.visualstudio.com/docs/reference/tasks-appendix#_schema-for-tasksjson"
          },
          // g vscode glob reference
          {
            "key": "g",
            "name": "Open vscode glob pattern reference",
            "icon": "globe",
            "type": "command",
            "command": "vscode.open",
            "args": "https://code.visualstudio.com/docs/editor/glob-patterns"
          }
        ]
      },
      // a profile
      {
        "key": "a",
        "name": "+Profile",
        "icon": "defaultProfile-icon",
        "type": "bindings",
        "bindings": [
          // a switch profile
          {
            "key": "a",
            "name": "switch profile",
            "type": "command",
            "command": "workbench.profiles.actions.switchProfile"
          },
          // o new window with profile
          {
            "key": "o",
            "name": "new window with profile",
            "type": "command",
            "bindings": [
              {
                "key": "o",
                "name": "new window with profile",
                "type": "command",
                "command": "workbench.profiles.actions.newWindowWithProfile"
              },
              {
                "key": "d",
                "name": "new window with default profile",
                "type": "command",
                "command": "workbench.action.openProfile.Default"
              }
            ]
          },
          {
            "key": " ",
            "name": "open profile ui interfact",
            "type": "command",
            "command": "workbench.profiles.actions.manageProfiles"
          },
          // delete profile
          {
            "key": "d",
            "name": "delete profile",
            "type": "command",
            "command": "workbench.profiles.actions.deleteProfile"
          },
          // t temporary profile
          {
            "key": "t",
            "name": "temporary profile",
            "type": "command",
            "command": "workbench.profiles.actions.createTemporaryProfile"
          },
          // n new profile
          {
            "key": "n",
            "name": "new profile",
            "type": "command",
            "command": "workbench.profiles.actions.createProfile"
          },
          // c copy current profile
          {
            "key": "c",
            "name": "copy current profile",
            "type": "command",
            "command": "workbench.profiles.actions.createFromCurrentProfile"
          },
          // y export profile
          {
            "key": "y",
            "name": "export profile",
            "type": "command",
            "command": "workbench.profiles.actions.exportProfile"
          },
          // x clean up profile
          {
            "key": "x",
            "name": "clean up profiles",
            "type": "command",
            "command": "workbench.profiles.actions.cleanupProfiles"
          },
          // r reset profile association
          {
            "key": "r",
            "name": "reset profile association",
            "type": "command",
            "command": "workbench.profiles.actions.resetWorkspaces"
          }
        ]
      }
    ]
  }
]
