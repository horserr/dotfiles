[
  {
    "key": "r",
    "name": "+Run",
    "icon": "run",
    "type": "bindings",
    "bindings": [
      // . rerun last task
      {
        "key": ".",
        "name": "Rerun last task",
        "icon": "debug-rerun",
        "type": "command",
        "command": "workbench.action.tasks.reRunTask"
      },
      // , configure task
      {
        "key": ",",
        "name": "Configure task",
        "icon": "gear",
        "type": "command",
        "command": "workbench.action.tasks.configureTaskRunner"
      },
      // space select task to run
      {
        "key": " ",
        "name": "select task",
        "icon": "play",
        "type": "command",
        "command": "workbench.action.tasks.runTask"
      },
      // / show running task
      {
        "key": "/",
        "name": "Show running tasks",
        "icon": "checklist",
        "type": "command",
        "command": "workbench.action.tasks.showTasks"
      },
      // b run build task
      {
        "key": "b",
        "name": "Run build tasks",
        "icon": "server-process",
        "type": "command",
        "command": "workbench.action.tasks.build"
      },
      // l show task log
      {
        "key": "l",
        "name": "Show task log",
        "icon": "history",
        "type": "command",
        "command": "workbench.action.tasks.showLog"
      },
      // t run test task
      {
        "key": "t",
        "name": "run test task",
        "icon": "beaker",
        "type": "command",
        "command": "workbench.action.tasks.test"
      },
      // d terminal task
      {
        "key": "d",
        "name": "Terminate task",
        "icon": "trash",
        "type": "command",
        "command": "workbench.action.tasks.terminate"
      },
      // R restart running task
      {
        "key": "R",
        "name": "Restart running task",
        "icon": "refresh",
        "type": "command",
        "command": "workbench.action.tasks.restartTask"
      }
    ]
  }
]
