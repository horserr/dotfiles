[
  // uv.searchPackage

  // pyrefly.foldAllDocstrings
  // pyrefly.infer
  // pyrefly.restartClient
  // pyrefly.runMain
  // pyrefly.runTest
  // pyrefly.unfoldAllDocstrings

  // debugpy.clearCacheAndReload
  // vscode-python-web-wasm.repl.start
  // vscode-python-web-wasm.debug.runEditorContents
  // vscode-python-web-wasm.debug.debugEditorContents
  {
    "key": "languageId:python",
    "name": "Python",
    "type": "bindings",
    "bindings": [
      // space select interpreter
      {
        "key": " ",
        "name": "select interpreter",
        "icon": "package",
        "type": "command",
        "command": "python.setInterpreter"
      },
      // , active virtual environment
      {
        "key": ",",
        "name": "activate virtual environment",
        "icon": "activate-breakpoints",
        "type": "command",
        // uv.manageVirtualEnv this command creates virtual environment
        "command": "uv.activateVirtualEnv"
      },
      // < python repl
      {
        "key": "<",
        "name": "Start REPL",
        "icon": "repl",
        "type": "bindings",
        "bindings": [
          {
            "key": "<",
            "name": "Start native REPL",
            "icon": "repl",
            "type": "command",
            "command": "python.startNativeREPL"
          },
          {
            "key": ",",
            "name": "Start terminal REPL",
            "icon": "repl",
            "type": "command",
            "command": "python.startREPL"
          }
        ]
      },
      // r run
      {
        "key": "r",
        "name": "+Run",
        "icon": "run",
        "type": "bindings",
        "bindings": [
          // r run file
          {
            "key": "r",
            "name": "run/execute file in terminal",
            "icon": "terminal",
            "type": "command",
            // "command": "python.execInTerminal"
            "command": "uv.runScript"
          },
          // t run tool
          {
            "key": "r",
            "name": "run tool",
            "icon": "terminal",
            "type": "command",
            "command": "uv.runTool"
          },
          // x execute selection
          {
            "key": "x",
            "name": "Send line/selection to REPL",
            "icon": "selection",
            "type": "command",
            // python.execSelectionInDjangoShell
            "command": "python.execSelectionInTerminal"
          }
        ]
      },
      // i initialize
      {
        "key": "i",
        "name": "Initialize/create environment",
        "icon": "chat-model-provider-gemini",
        "type": "command",
        // "command": "python.createEnvironment"
        "command": "uv.init"
      },
      // a add
      {
        "key": "a",
        "name": "+Add",
        "icon": "add-small",
        "type": "bindings",
        "bindings": [
          // a add
          {
            "key": "a",
            "name": "uv add",
            "icon": "add",
            "type": "command",
            "command": "uv.add"
          },
          // d add dev
          {
            "key": "d",
            "name": "uv add dev",
            "icon": "add",
            "type": "command",
            "command": "uv.addDev"
          },
          // . add script dependency
          {
            "key": ".",
            "name": "uv add script dependency",
            "icon": "add",
            "type": "commands",
            "commands": ["uv.setPep723Interpreter", "uv.addScriptDependency"]
          }
        ]
      },
      // u upgrade
      {
        "key": "u",
        "name": "Upgrade/Sync",
        "icon": "getting-started-setup",
        "type": "bindings",
        "bindings": [
          // s sync
          {
            "key": "s",
            "name": "uv sync dependencies",
            "icon": "getting-started-setup",
            "type": "command",
            "command": "uv.sync"
          },
          // u upgrade dependencies
          {
            "key": "u",
            "name": "uv upgrade dependencies",
            "icon": "getting-started-setup",
            "type": "command",
            // uv.upgrade this command is superseded
            "command": "uv.upgradeDependencies"
          }
        ]
      },
      // l lock
      {
        "key": "l",
        "name": "uv generate lock file",
        "icon": "lock",
        "type": "command",
        "command": "uv.generateLock"
      },
      // d remove
      {
        "key": "d",
        "name": "remove packages",
        "icon": "remove",
        "type": "command",
        "command": "uv.removePackage"
      },
      // t configure test
      {
        "key": "t",
        "name": "connfigure tests",
        "icon": "test-view-icon",
        "type": "command",
        "command": "python.configureTests"
      },
      // * misc
      {
        "key": "*",
        "name": "+Misc",
        "icon": "debug-restart-frame",
        "type": "bindings",
        "bindings": [
          // r restart server
          {
            "key": "r",
            "name": "restart server",
            "icon": "debug-restart-frame",
            "type": "commands",
            // "command": "python.analysis.restartLanguageServer"
            // python.clearCacheAndReload
            // "commands": ["ty.restart", "ruff.restart"]
            "commands": ["ruff.restart"]
          },
          // x clear workspace interpreter setting
          {
            "key": "x",
            "name": "clear workspace interpreter setting",
            "icon": "debug-console-clear-all",
            "type": "command",
            "command": "python.clearWorkspaceInterpreter"
          }
        ]
      },
      // p pin python
      {
        "key": "p",
        "name": "pin python",
        "icon": "pin",
        "type": "command",
        "command": "uv.pinPython"
      },
      // x clean cache
      {
        "key": "x",
        "name": "clean uv cache",
        "icon": "debug-remove-config",
        "type": "command",
        "command": "uv.cache.clean"
      },
      // I Install
      {
        "key": "I",
        "name": "+Install",
        "icon": "extensions-install-count",
        "type": "bindings",
        "bindings": [
          // j instal jupyter extension
          {
            "key": "j",
            "name": "Install jupyter extension",
            "icon": "extensions-install-count",
            "type": "command",
            "command": "python.installJupyter"
          },
          // u install uv
          {
            "key": "u",
            "name": "Install uv",
            "icon": "extensions-install-count",
            "type": "command",
            "command": "uv.installUv"
          },
          // t install tools
          {
            "key": "t",
            "name": "Install tools",
            "icon": "extensions-install-count",
            "type": "command",
            "command": "uv.installTool"
          },
          // p install python
          {
            "key": "p",
            "name": "Install python",
            "icon": "python",
            "type": "command",
            "command": "uv.installPython"
          }
        ]
      }
    ]
  }
]
