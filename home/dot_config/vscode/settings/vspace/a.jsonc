[
  {
    "key": "a",
    "name": "+Azure",
    "icon": "azure",
    "type": "bindings",
    "bindings": [
      // r registry
      {
        "key": "r",
        "name": "+Registry",
        "type": "bindings",
        "bindings": [
          // b build image
          {
            "key": "b",
            "name": "build image",
            "icon": "azure",
            "type": "command",
            "command": "vscode-containers.registries.azure.buildImage"
          },
          // u untag image
          {
            "key": "u",
            "name": "untag image",
            "icon": "azure",
            "type": "command",
            "command": "vscode-containers.registries.azure.untagImage"
          },
          // a create registry
          {
            "key": "a",
            "name": "create registry",
            "icon": "azure",
            "type": "command",
            "command": "vscode-containers.registries.azure.createRegistry"
          },
          // d delete
          {
            "key": "d",
            "name": "+Delte",
            "icon": "azure",
            "type": "bindings",
            "bindings": [
              {
                "key": "d",
                "name": "delete registry",
                "icon": "azure",
                "type": "command",
                "command": "vscode-containers.registries.azure.deleteRegistry"
              },
              {
                "key": "r",
                "name": "delete repository",
                "icon": "azure",
                "type": "command",
                "command": "vscode-containers.registries.azure.deleteRepository"
              }
            ]
          },
          // o open in portal
          {
            "key": "o",
            "name": "open registry in portal",
            "icon": "azure",
            "type": "command",
            "command": "vscode-containers.registries.azure.openInPortal"
          },
          // i inspect registry properties
          {
            "key": "i",
            "name": "inspect registry properties",
            "icon": "azure",
            "type": "command",
            "command": "vscode-containers.registries.azure.viewProperties"
          }
        ]
      }
    ]
  }
]
