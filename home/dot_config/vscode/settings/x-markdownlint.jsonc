{
  "$help": "https://github.com/davidanson/markdownlint",

  // Path to a configuration file that defines the base configuration.
  "markdownlint.configFile": null,

  // Makes it easier to focus while typing by hiding issues on or near the current line.
  "markdownlint.focusMode": true,

  // Array of glob expressions to include or ignore when linting a workspace with the "lintWorkspace" command.
  "markdownlint.lintWorkspaceGlobs": [
    "**/*.{md,mkd,mdwn,mdown,markdown,markdn,mdtxt,mdtext,workbook}",
    "!**/*.code-search",
    "!**/bower_components",
    "!**/node_modules",
    "!**/.git",
    "!**/vendor"
  ],

	// Specifies whether to lint all files, workspace files, "project" files, or no files.
	"markdownlint.appliesTo": "allFiles",

	// JSON Pointer to a configuration object within the "configFile" file.
	"markdownlint.configPointer": null,

	// VS Code diagnostic level to use for issues with severity "error".
	"markdownlint.severityForError": "Warning",

	// VS Code diagnostic level to use for issues with severity "warning".
	"markdownlint.severityForWarning": "Information",

  // Run the linter on save ("onSave") or on type ("onType").
  "markdownlint.run": "onType"
}
