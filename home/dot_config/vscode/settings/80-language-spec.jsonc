{
  "[ahk2]": {
    "editor.defaultFormatter": "mark-wiemer.vscode-autohotkey-plus-plus"
  },
  "[html, css, json, js, ts, tsx, jsx, http]": {
    "editor.defaultFormatter": "esbenp.prettier-vscode",
    "files.autoSave": "onWindowChange"
    /* cannot set here     "editor.wordWrapColumn": 80,
    "editor.wordWrap": "bounded" // this setting file cannot display this bounded wrap effect */
  },
  "[ini][toml]": {
    "editor.defaultFormatter": "tamasfe.even-better-toml"
  },
  "[json]": {
    "editor.defaultFormatter": "esbenp.prettier-vscode"
  },
  "[jsonc]": {
    "editor.defaultFormatter": "esbenp.prettier-vscode",
    "prettier.trailingComma": "none"
  },
  "[powershell]": {
    "editor.defaultFormatter": "ms-vscode.powershell"
  },
  "[prolog]": {
    "editor.defaultFormatter": "AmauryRabouan.new-vsc-prolog"
  },
  "[dockerfile]": {
    "editor.defaultFormatter": "ms-azuretools.vscode-containers"
  },
  "[shellscript]": {
    "editor.defaultFormatter": "mads-hartmann.bash-ide-vscode"
  },
  "[rust]": {
    "editor.defaultFormatter": "rust-lang.rust-analyzer"
  },
  "[snippets]": {
    "editor.defaultFormatter": "vscode.json-language-features"
  },
  "[sql]": {
    "editor.defaultFormatter": "dbcode.dbcode"
  },
  "[xml, wsb]": {
    "editor.defaultFormatter": "redhat.vscode-xml"
  },
  "[yaml]": {
    "editor.defaultFormatter": "redhat.vscode-yaml"
  },
  "[log]": { "editor.wordWrap": "off" },
  /*******
   * CSS *
   *******/
  "css.validate": true,
  /***************************
   * JAVASCRIPT & TYPESCRIPT *
   ***************************/
  "js/ts.inlayHints.enumMemberValues.enabled": true,
  "js/ts.inlayHints.functionLikeReturnTypes.enabled": true,
  "js/ts.inlayHints.parameterTypes.enabled": true,
  "js/ts.inlayHints.propertyDeclarationTypes.enabled": true,
  "js/ts.inlayHints.variableTypes.enabled": true,
  "js/ts.preferences.importModuleSpecifier": "non-relative",
  "js/ts.updateImportsOnFileMove.enabled": "always",
  /**************
   * POWERSHELL *
   **************/
  "powershell.integratedConsole.showOnStartup": false,
  "powershell.integratedConsole.startInBackground": true,
  /********
   * RUST *
   ********/
  "rust-analyzer.check.command": "clippy",
  "rust-analyzer.showSyntaxTree": true,
  /********
   * SCSS *
   ********/
  "scss.validate": true,
  /*********
   * TYPST *
   *********/
  "tinymist.lint.enabled": true,
  "tinymist.lint.when": "onType",
  "tinymist.preview.cursorIndicator": true,
  "tinymist.preview.invertColors": "auto",
}
