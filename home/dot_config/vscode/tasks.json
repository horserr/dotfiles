{
  // See https://go.microsoft.com/fwlink/?LinkId=733558
  // for the documentation about the tasks.json format
  "version": "2.0.0",
  "tasks": [
    // git add current file
    {
      // why create this command given existing git.add vscode command
      // because the native command cannot add unstaged files
      "label": "git: Add Current File",
      "type": "shell",
      "command": "git",
      "args": ["add", "${relativeFile}"],
      "detail": "add current file",
      "icon": { "id": "add" },
      "presentation": {
        "echo": true,
        "reveal": "silent",
        "focus": false,
        "panel": "shared",
        "showReuseMessage": true,
        "clear": false
      }
    },
    // git check file attributes
    {
      "label": "git: Check File Attributes",
      "type": "shell",
      "command": "git",
      "args": ["check-attr", "-a", "${relativeFile}"],
      "detail": "show the git attributes applied to the current file",
      "runOptions": {
        "instanceLimit": 1,
        "instancePolicy": "terminateOldest",
        "runOn": "folderOpen"
      },
      "icon": { "id": "graph-scatter" },
      "presentation": {
        "echo": true,
        "reveal": "always",
        "focus": false,
        "panel": "shared",
        "showReuseMessage": true,
        "clear": false
      }
    },
    // git turn file executable
    {
      "label": "git: Mark File Executable",
      "type": "shell",
      "command": "git",
      "args": ["update-index", "--chmod=+x", "${relativeFile}"],
      "detail": "record the executable bit of the current file in the index",
      "runOptions": {
        "instanceLimit": 1,
        "instancePolicy": "terminateOldest",
        "runOn": "folderOpen"
      },
      "icon": { "id": "play" },
      "presentation": {
        "echo": true,
        "reveal": "always",
        "focus": false,
        "panel": "shared",
        "showReuseMessage": true,
        "clear": false
      }
    },
    // git test file executable
    {
      "label": "git: Test File Executable",
      "type": "shell",
      "command": "git",
      "args": ["is-x", "${relativeFile}"],
      "detail": "check whether the current file is recorded as executable",
      "runOptions": {
        "instanceLimit": 1,
        "instancePolicy": "terminateOldest",
        "runOn": "folderOpen"
      },
      "icon": { "id": "beaker" },
      "presentation": {
        "echo": true,
        "reveal": "always",
        "focus": false,
        "panel": "shared",
        "showReuseMessage": true,
        "clear": false
      }
    },
    // git fixup commit
    {
      "label": "git: Create Fixup Commit",
      "type": "shell",
      "command": "git",
      "args": ["commit", "--fixup=${input:commit}"],
      "detail": "commit staged changes as a `fixup!` commit for the target commit; apply it later with `git: Interactive Rebase`",
      "icon": { "id": "git-commit" },
      "presentation": {
        "echo": true,
        "reveal": "always",
        "focus": true,
        "panel": "shared",
        "showReuseMessage": true,
        "clear": false
      }
    },
    // git squash commit
    {
      "label": "git: Create Squash Commit",
      "type": "shell",
      "command": "git",
      "args": ["commit", "--squash=${input:commit}"],
      "detail": "commit staged changes as a `squash!` commit for the target commit; apply it later with `git: Interactive Rebase` and edit the combined message",
      "icon": { "id": "git-merge" },
      "presentation": {
        "echo": true,
        "reveal": "always",
        "focus": true,
        "panel": "shared",
        "showReuseMessage": true,
        "clear": false
      }
    },
    // git interactive rebase
    {
      "label": "git: Interactive Rebase",
      "type": "shell",
      "command": "git",
      "args": ["rebase", "--interactive", "${input:commit}"],
      "detail": "rebase onto the target commit; `rebase.autosquash` is on, so `fixup!`/`squash!` commits are moved to their targets",
      "icon": { "id": "git-compare" },
      "presentation": {
        "echo": true,
        "reveal": "always",
        "focus": true,
        "panel": "dedicated",
        "showReuseMessage": true,
        "clear": false
      }
    },
    // docker desktop start
    {
      "label": "docker: Start Desktop",
      "type": "shell",
      "command": "docker",
      "args": ["desktop", "start"],
      "detail": "start the Docker Desktop engine",
      "runOptions": {
        "instanceLimit": 1,
        "instancePolicy": "terminateOldest",
        "runOn": "folderOpen"
      },
      "icon": { "id": "debug-start" },
      "presentation": {
        "echo": true,
        "reveal": "silent",
        "focus": false,
        "panel": "shared",
        "showReuseMessage": true,
        "clear": false
      }
    },
    // docker desktop stop
    {
      "label": "docker: Stop Desktop",
      "type": "shell",
      "command": "docker",
      "args": ["desktop", "stop"],
      "detail": "stop the Docker Desktop engine",
      "runOptions": {
        "instanceLimit": 1,
        "instancePolicy": "terminateOldest",
        "runOn": "folderOpen"
      },
      "icon": { "id": "debug-breakpoint-pending" },
      "presentation": {
        "echo": true,
        "reveal": "silent",
        "focus": false,
        "panel": "shared",
        "showReuseMessage": true,
        "clear": false
      }
    },
    // chezmoi install
    {
      "label": "chezmoi: Install",
      "type": "shell",
      "detail": "install chezmoi (scoop on Windows, official script elsewhere)",

      // detect root user
      "command": "sh -c 'if [ \"$(id -u)\" -eq 0 ]; then target=\"/usr/local/bin\"; else target=\"$HOME/.local/bin\"; fi; sh -c \"$(curl -fsLS https://get.chezmoi.io)\" -- -b \"$target\"'",

      "icon": { "id": "cloud-download" },
      "windows": { "command": "scoop install chezmoi" },
      "presentation": {
        "echo": true,
        "reveal": "always",
        "focus": true,
        "panel": "shared",
        "showReuseMessage": true,
        "clear": true
      }
    },
    // chezmoi init and apply
    {
      "label": "chezmoi: Init and Apply",
      "type": "shell",
      "command": "chezmoi init --source=~/.config/.dotfiles --apply horserr",
      "detail": "initialize from horserr/dotfiles using this checkout as the source, then apply",
      "icon": { "id": "repo-clone" },
      "presentation": {
        "echo": true,
        "reveal": "always",
        "focus": true,
        "panel": "shared",
        "showReuseMessage": true,
        "clear": true
      }
    },
    // chezmoi init
    {
      "label": "chezmoi: Init",
      "type": "shell",
      "command": "chezmoi init --source=~/.config/.dotfiles horserr",
      "detail": "initialize from horserr/dotfiles using this checkout as the source",
      "icon": { "id": "repo-clone" },
      "presentation": {
        "echo": true,
        "reveal": "always",
        "focus": true,
        "panel": "shared",
        "showReuseMessage": true,
        "clear": true
      }
    },
    // chezmoi update
    {
      "label": "chezmoi: Update",
      "type": "shell",
      "command": "chezmoi update",
      "detail": "pull the source state and apply the newest changes",
      "icon": { "id": "sync" },
      "presentation": {
        "echo": true,
        "reveal": "always",
        "focus": true,
        "panel": "shared",
        "showReuseMessage": true,
        "clear": true
      }
    },
    // chezmoi self upgrade
    {
      // link: https://www.chezmoi.io/reference/commands/upgrade/
      "label": "chezmoi: Self Upgrade",
      "type": "shell",
      "command": "chezmoi upgrade",
      "detail": "downloading and installing the latest released version",
      "icon": { "id": "arrow-circle-up" },
      "options": {
        "env": { "CHEZMOI_GITHUB_ACCESS_TOKEN": "${env:GH_TOKEN}" }
      },
      "presentation": {
        "echo": true,
        "reveal": "always",
        "focus": true,
        "panel": "shared",
        "showReuseMessage": true,
        "clear": true
      }
    },
    // chezmoi apply
    {
      "label": "chezmoi: Apply",
      "type": "shell",
      "command": "chezmoi apply",
      "detail": "apply pending source changes to the target files",
      "icon": { "id": "check" },
      "presentation": {
        "echo": true,
        "reveal": "always",
        "focus": true,
        "panel": "shared",
        "showReuseMessage": true,
        "clear": true
      }
    },
    // chezmoi edit config
    {
      "label": "chezmoi: Edit Config",
      "type": "shell",
      "command": "chezmoi edit-config",
      "detail": "open the chezmoi configuration file in the editor",
      "icon": { "id": "gear" }
    },
    // chezmoi edit config template
    {
      "label": "chezmoi: Edit Config Template",
      "type": "shell",
      "command": "chezmoi edit-config-template",
      "detail": "open the chezmoi template file in the editor",
      "icon": { "id": "gear" }
    },
    // mousemaster start
    {
      "label": "mousemaster: Start",
      "type": "shell",
      // "type": "process",
      "command": "start mousemaster.exe",
      // "command": "mousemaster.exe",
      "detail": "start a throwaway mousemaster instance from ~/.config/mousemaster",
      "options": { "cwd": "${env:USERPROFILE}/.config/mousemaster" },
      "group": "test",
      "icon": { "id": "key" },
      "runOptions": { "instanceLimit": 1, "instancePolicy": "prompt" },
      "presentation": {
        "echo": true,
        "reveal": "silent",
        "focus": false,
        "panel": "shared",
        "showReuseMessage": true,
        "clear": false
      }
    },
    {
      "label": "workspace: Project Tree",
      "type": "shell",
      "command": "tree -a",
      "windows": {
        // for ascii character
        // "command": "tree /f /a"
        "command": "Get-ChildItem -Recurse | clip"
      },
      "detail": "print the project tree (Windows: copy it to the clipboard)",
      "icon": { "id": "key" },
      "presentation": {
        "echo": true,
        "reveal": "always",
        "focus": true,
        "panel": "shared",
        "showReuseMessage": true,
        "clear": false
      }
    }
  ],
  "inputs": [
    {
      "id": "commit",
      "type": "promptString",
      "description": "target commit: fixup/squash target or rebase base (hash, ref or HEAD~n)"
    }
  ],
  "linux": {
    "options": {
      "shell": {
        "executable": "bash",
        // -i: force reparse .bashrc
        "args": ["-i", "-c"]
      }
    }
  },
  "windows": {
    "options": {
      "shell": {
        "executable": "pwsh",
        "args": ["-NoProfile", "-c"]
      },
      "env": {
        // "http_proxy": "http://localhost:7890",
        // "https_proxy": "http://localhost:7890",
        // "HTTP_PROXY": "http://localhost:7890",
        // "HTTPS_PROXY": "http://localhost:7890"
      }
    }
  },
  "options": {
    "env": {
      "VISUAL": "code --wait",
      "GITHUB_ACCESS_TOKEN": "${env:GH_TOKEN}"
    }
  }
}
