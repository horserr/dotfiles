{
  "env": {
    "ANTHROPIC_BASE_URL": "https://api.deepseek.com/anthropic",
    "ANTHROPIC_AUTH_TOKEN": {{ .token.deepseek | quote }},
    "CLAUDE_CODE_DISABLE_NONESSENTIAL_TRAFFIC": "1",
    "CLAUDE_EFFORT": "high",
    "CLAUDE_CODE_AUTO_COMPACT_WINDOW": "786432",
    "NTFY_APPROVALS_APPROVE":"0",
    "DISABLE_AUTOUPDATER": "1"
  },
  "enabledPlugins": {
    "ntfy-approvals@dotfiles": true
  },
  "extraKnownMarketplaces": {
    "dotfiles": {
      "source": {
        "source": "directory",
        "path": {{ printf "%s/claude-plugins" (dir .chezmoi.sourceDir) | quote }}
      }
    }
  },
  "editorMode": "vim",
  "theme": "auto"
}
