{
  "theme": "auto",
  "editorMode": "vim",

  "max_context_tokens": 1048576,

  "env": {
    "CLAUDE_CODE_AUTO_MODE_SERVER": "0",
    /* Models starting with claude-opus are mapped to deepseek-v4-pro
    Models starting with claude-haiku or claude-sonnet are mapped to deepseek-flash
    link: https://api-docs.deepseek.com/quick_start/agent_integrations/claude_code/#model-mapping-when-using-claude-code-or-claude-desktop-app
    */

    // deepseek token
    "ANTHROPIC_AUTH_TOKEN": {{ .token.deepseek | quote }},
    // deepseek url
    "ANTHROPIC_BASE_URL": "https://api.deepseek.com/anthropic",
    // deepseek recommend compact window
    "CLAUDE_CODE_AUTO_COMPACT_WINDOW": "786432",

    // default subagent model is `inherit`, which is same with selected model
    "CLAUDE_CODE_SUBAGENT_MODEL":"sonnet",

    // disable telemetry and crash report
    "CLAUDE_CODE_DISABLE_NONESSENTIAL_TRAFFIC": "1",

    // interactive /init command
    "CLAUDE_CODE_NEW_INIT ": "1",

    // deepseek thinking effort
    "CLAUDE_EFFORT": "high",

    // disable claude autoupdate, using chezmoi external to manage it
    "DISABLE_AUTOUPDATER": "1",

    // claude using powershell on Windows
    "CLAUDE_CODE_USE_POWERSHELL_TOOL": {{ ternary "1" "0" .isWindows | quote }},

    "NTFY_APPROVALS_APPROVE": "0"
  },
  "enabledPlugins": {
    "agent-sdk-dev@claude-plugins-official": true,
    "astral@astral-sh": true,
    "claude-code-setup@claude-plugins-official": true,
    "claude-md-management@claude-plugins-official": true,
    "code-review@claude-plugins-official": true,
    "context7@claude-plugins-official": true,
    "document-skills@anthropic-agent-skills": true,
    "frontend-design@claude-plugins-official": true,
    "humanizer@humanizer": true,
    "mattpocock-skills@claude-plugins-official": true,
    "plugin-dev@claude-plugins-official": true,
    "research@dotfiles": true,
    "skill-creator@claude-plugins-official": true,
    "superpowers@claude-plugins-official": true,
    // "github@claude-plugins-official": true,
  },
  "skillOverrides": {
    "reverse-engineer-anything": "off"
  },
  "extraKnownMarketplaces": {
    "claude-plugins-official": {
      "source": {
        "source": "github",
        "repo": "anthropics/claude-plugins-official"
      }
    },
     "astral-sh": {
      "source": {
        "source": "github",
        "repo": "astral-sh/claude-code-plugins"
      }
    },
    "buildwithclaude": {
      "source": {
        "source": "github",
        "repo": "davepoon/buildwithclaude"
      }
    },
     "voltagent-subagents": {
      "source": {
        "source": "github",
        "repo": "VoltAgent/awesome-claude-code-subagents"
      }
    },
     "humanizer": {
      "source": {
        "source": "github",
        "repo": "blader/humanizer"
      }
    },
    "dotfiles": {
      "source": {
        "source": "directory",
        "path": {{ printf "%s/claude-plugins" (dir .chezmoi.sourceDir) | quote }}
      }
    }
  },
  "skipWorkflowUsageWarning": true,
  // disable OAuth check
  "hasCompletedOnboarding": true
}
