# copied from: github.com/mathiasbynens/dotfiles/blob/main/.inputrc

# set menu-complete-display-prefix on
# # tab key for menu completion

# # Source - https://stackoverflow.com/a/12045476
# # Posted by John Wordsworth, modified by community. See post 'Timeline' for change history

# TAB: menu-complete
# "\e[Z": menu-complete-backward


# Make Tab autocomplete regardless of filename case
set completion-ignore-case on
set completion-map-case on

# List all matches in case multiple possible completions are possible
set show-all-if-unmodified on
set show-all-if-ambiguous on

set visible-stats on
set colored-stats on
set colored-completion-prefix on
set completion-prefix-display-length 3

# Immediately add a trailing slash when autocompleting symlinks to directories
set mark-directories on
set mark-symlinked-directories on

# link: https://unix.stackexchange.com/questions/27699/remap-bash-vi-keys
# https://vim.fandom.com/wiki/Use_vi_shortcuts_in_terminal
# https://www.reddit.com/r/vim/comments/1emhips/using_vim_keybindings_in_bash_cli/
# https://github.com/pkrumins/bash-vi-editing-mode-cheat-sheet/tree/master
set editing-mode vi
# NOTE:
#   - `bind -P` check all builtin commands（e.g. clear-screen）
#   -  `bind -m vi-command -p` 查看当前命令模式下已生效的所有快捷键。

# 显示当前处于哪种模式（在提示符前显示 (ins) 或 (cmd)）
set show-mode-in-prompt on

# 更改光标形状区分模式（输入模式为竖线 |，命令模式为方块 █）
set vi-ins-mode-string \1\e[6 q\2
set vi-cmd-mode-string \1\e[2 q\2

# 缩短 Esc 键延迟（默认 500ms 会有卡顿感，设为 50ms 瞬间响应）
set keyseq-timeout 50

set bell-style none

# --------------------------------------------------
# Vi Keybindings
# --------------------------------------------------

$if mode=vi

	# ==============================================
	# Normal / Command Mode
	# ==============================================

	set keymap vi-command

	# History
	"k": history-search-backward
	"j": history-search-forward
	"K": history-substring-search-backward
	"J": history-substring-search-forward

	"\C-r": reverse-search-history
	"\C-s": forward-search-history

	# Movement
	"H": beginning-of-line
	"L": end-of-line

	# Screen
	"\C-l": clear-screen

	# Quick sudo
	"ss": "Isudo \eA"

	# Shell macros
	",p": "A | "
	",g": "A | grep "
	",l": "A | less\e"
	",r": "A > "
	",b": "A &\e"
	",c": "I# \e"

	# Expansion (Bash only)
	$if Bash
		",h": history-expand-line
		",a": alias-expand-line
		",e": history-and-alias-expand-line
		",x": shell-expand-line

		# 默认 v 已绑定外部编辑器
		# "V": edit-and-execute-command
	$endif

	# Reload inputrc
	",R": re-read-init-file

	# ==============================================
	# Insert Mode
	# ==============================================

	set keymap vi-insert

	# Exit insert mode (optional)
	# "jk": vi-movement-mode

	# Emacs-style movement
	"\C-a": beginning-of-line
	"\C-e": end-of-line
	"\C-b": backward-char
	"\C-f": forward-char

	# Word movement
	"\eb": backward-word
	"\ef": forward-word

	# Editing
	"\C-w": unix-word-rubout
	"\C-u": unix-line-discard
	"\C-k": kill-line
	"\C-y": yank
	"\C-_": undo

	# History
	"\C-r": reverse-search-history
	"\C-s": forward-search-history

	"\e[A": history-search-backward
	"\e[B": history-search-forward

	# Completion
	"\C-n": menu-complete
	"\C-p": menu-complete-backward

	# Reuse previous command arguments
	"\e.": yank-last-arg

	# Screen
	"\C-l": clear-screen

	# External editor
	$if Bash
		"\C-x\C-e": edit-and-execute-command
	$endif

$endif

