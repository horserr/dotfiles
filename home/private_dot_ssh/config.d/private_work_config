Host robotwin
    # Tag WORK
    User root
    ForwardAgent yes
    HostName localhost
    Port 2222

    IdentityFile ~/.ssh/work
    IdentitiesOnly no

    ProxyJump work

    Compression yes

    # don't display know host warning every time the container was rebuilt
    StrictHostKeyChecking no
    UserKnownHostsFile /dev/null
