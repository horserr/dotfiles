#cloud-config
package_update: true
package_upgrade: true

timezone: Asia/Shanghai
locale: en_US.UTF-8

users:
  - name: wsl
    groups:
      [docker, adm, dialout, cdrom, floppy, sudo, audio, dip, video, plugdev, netdev]
    sudo: ALL=(ALL) NOPASSWD:ALL
    shell: /bin/bash

write_files:
  - path: /etc/wsl.conf
    append: true
    content: |
      [network]
      generateHosts = true
      [user]
      default=wsl

packages:
  - openssh-server
  # - incus

runcmd:
  - sh -c "$(curl -fsLS get.chezmoi.io)" -- -b /usr/local/bin
  # - chezmoi init --source=~/.config/.dotfiles --apply horserr
