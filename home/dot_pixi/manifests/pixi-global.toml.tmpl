version = 1

[envs.ruff]
dependencies = ["ruff"]

{{ if .init.install }}
    {{- /* prepend essential to group list */ -}}
    {{- $groups := list "essential" -}}
    {{- range .init.extras -}}
        {{- $groups = append $groups . -}}
    {{- end -}}

    {{- /* loop through all categories */ -}}
    {{- range $category, $apps := .linuxapps -}}
        {{- /* skip categories not in group */ -}}
        {{- if has $category $groups -}}

            {{- /* add specific app */ -}}

            {{- range $apps -}}
            {{- /* 兼容处理：支持纯字符串形式和带 canonical/name 的对象形式 */ -}}
                {{- $pkgName := "" -}}
                {{- $execName := "" -}}

                {{- if kindIs "map" . -}}
                  {{- $pkgName = default .name .canonical -}}
                  {{- $execName = .name -}}
                {{- else -}}
                  {{- $pkgName = . -}}
                  {{- $execName = . -}}
            {{- end }}

[envs.{{ $execName }}]
dependencies = { {{ $pkgName }} = "*" }
exposed = { {{ $execName }} = "{{ $execName }}" }

            {{ end -}}
        {{- end -}}
    {{- end -}}
{{- end }}
