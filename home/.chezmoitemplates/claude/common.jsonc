{
  // comprehensive settings: https://www.dsebastien.net/claude-code-configuration/
  "theme": "auto",
  "editorMode": "vim",

  "max_context_tokens": 1048576,

  "verbose": false,

  // auto or terminal_bell
  "preferredNotifChannel": "terminal_bell",

  // whether to show thinking blocks in the output. Since 2.1.69+, hidden by default via a beta header that tells the API to skip thinking summaries, which reduces latency. This is a UI-only change; it does not affect thinking itself, thinking budgets, or how extended reasoning works under the hood.
  "showThinkingSummaries": true,

  "autoMemoryEnabled": true,
  "autoDreamEnabled": true,
  "autoCompactEnabled": true,
  "idleCompaction": true,

  "alwaysThinkingEnabled": true,

  "feedbackSurveyRate": 0,

  // Days local transcripts are kept: default 30, minimum 1
  "cleanupPeriodDays": 30,

  // Stops the WebFetch hostname safety check, which the one-flag switch does not cover
  "skipWebFetchPreflight": true,
  "permissions": {
    "defaultMode": {{ ternary "bypassPermissions" "auto" .isEphemeral | quote }},
    "allow": [
      "Bash",
      "WebFetch"
    ],
    "deny": [
      "Bash(rm -rf:*)",
      "Read(./.env)",
      "Bash(sudo:*)"
    ]
  },
  "skipDangerousModePermissionPrompt": {{ .isEphemeral }},
  // 准确变量名为 CLAUDE_CODE_EVEN_MORE_DANGEROUSLY_SKIP_PERMISSIONS=1）可连带解除对根目录或主目录 rm 命令的二次拦截

  "env": {
    // "CLAUDE_CODE_EXPERIMENTAL_AGENT_TEAMS": "1",
    "ENABLE_TOOL_SEARCH": "true",

    "CLAUDE_CODE_AUTO_MODE_SERVER": "0",
    /* Models starting with claude-opus are mapped to deepseek-v4-pro
    Models starting with claude-haiku or claude-sonnet are mapped to deepseek-flash
    link: https://api-docs.deepseek.com/quick_start/agent_integrations/claude_code/#model-mapping-when-using-claude-code-or-claude-desktop-app
    */

    "ANTHROPIC_MODEL": "opus",

    // default subagent model is `inherit`, which is same with selected model
    "CLAUDE_CODE_SUBAGENT_MODEL":"sonnet", // perfer sonnet/haiku

    /*******************
     * PRIVACY SETTING *
     *******************/
    // link: https://www.getvoibe.com/resources/claude-code-privacy-settings/

    "CLAUDE_CODE_DISABLE_NONSTREAMING_FALLBACK": "1",

    // Turns off auto-updates, telemetry, error reporting, /feedback, Claude-drafted feedback, release notes, PR status badge checks, availability checks and feature-flag fetching
    "CLAUDE_CODE_DISABLE_NONESSENTIAL_TRAFFIC": "1",

    // disabled by `disable non essential traffic`
    // // Stops usage metrics (never code, prompts or file paths) and feature-flag fetching
    // "DISABLE_TELEMETRY": "1",

    // // Same effect as DISABLE_TELEMETRY; a value of 0 leaves telemetry on
    // "DO_NOT_TRACK":"1",

    // // Stops error reports (secrets, file paths and emails are redacted before upload)
    // "DISABLE_ERROR_REPORTING": "1",

    // // Disables /feedback, /bug, /share and Claude-drafted feedback; the old name DISABLE_BUG_COMMAND still works
    // "DISABLE_FEEDBACK_COMMAND": "1",

    // // Stops background updates; DISABLE_UPDATES=1 also blocks manual updates
    // "DISABLE_AUTOUPDATER": "1",

    // // Turns off the session quality survey and its transcript follow-up
    // "CLAUDE_CODE_DISABLE_FEEDBACK_SURVEY": "1",

    // // Feature-flag fetching only; telemetry keeps running
    // "CLAUDE_CODE_DISABLE_FEATURE_FLAGS": "1",

    // Never writes session transcripts or prompt history to disk
    // "CLAUDE_CODE_SKIP_PROMPT_HISTORY": "1",

    // Skips registering the official plugin marketplace, also outside the one-flag switch
    "CLAUDE_CODE_DISABLE_OFFICIAL_MARKETPLACE_AUTOINSTALL": "1",

    // interactive /init command
    "CLAUDE_CODE_NEW_INIT ": "1",

    // deepseek thinking effort
    "CLAUDE_EFFORT": "high",

    // enables an experimental alternate-screen renderer in Claude Code
    "CLAUDE_CODE_NO_FLICKER": "1",

    // use bundled ripgrep instead of system one
    "USE_BUILTIN_RIPGREP": "1",

    "CLAUDE_CODE_IDE_AUTO_CONNECT": "1",
    "CLAUDE_CODE_IDE_SKIP_AUTO_INSTALL": "0",

    // claude using powershell on Windows
    "CLAUDE_CODE_USE_POWERSHELL_TOOL": {{ ternary "1" "0" .isWindows | quote }},

    "NTFY_APPROVALS_APPROVE": "0",
  },
  "enabledPlugins": {
    "agent-sdk-dev@claude-plugins-official": true,
    "claude-code-setup@claude-plugins-official": true,
    "claude-md-management@claude-plugins-official": true,
    "code-review@claude-plugins-official": true,
    "context7@claude-plugins-official": true,
    "document-skills@anthropic-agent-skills": true,
    "frontend-design@claude-plugins-official": true,
    "humanizer@humanizer": true,
    "mattpocock-skills@claude-plugins-official": true,
    "plugin-dev@claude-plugins-official": true,
    "pyrefly@dotfiles": true,
    "python-toolchain@dotfiles": true,
    "research@dotfiles": true,
    "skill-creator@claude-plugins-official": true,
    "superpowers@claude-plugins-official": true,
    // "github@claude-plugins-official": true,
  },
  "skillOverrides": {
    "reverse-engineer-anything": "off"
  },
  "extraKnownMarketplaces": {
    "claude-plugins-official": {
      "source": {
        "source": "github",
        "repo": "anthropics/claude-plugins-official"
      }
    },
    "buildwithclaude": {
      "source": {
        "source": "github",
        "repo": "davepoon/buildwithclaude"
      }
    },
    "voltagent-subagents": {
      "source": {
        "source": "github",
        "repo": "VoltAgent/awesome-claude-code-subagents"
      }
    },
    "humanizer": {
      "source": {
        "source": "github",
        "repo": "blader/humanizer"
      }
    },
    "dotfiles": {
      "source": {
        "source": "directory",
        "path": {{ printf "%s/claude-plugins" (dir .chezmoi.sourceDir) | quote }}
      }
    }
  },
  "skipWorkflowUsageWarning": true,
  // disable OAuth check
  "hasCompletedOnboarding": true,
}
