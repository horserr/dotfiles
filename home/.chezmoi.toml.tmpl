{{/* code: language=toml */}}

{{/* ------------------------------------------------------------------
     1. Environment & context detection
     Pure flags + external lookups — no user prompts in this section.
   ------------------------------------------------------------------ */}}

{{- /* Checks if running interactively, which is not the case for GitHub Codespaces */ -}}
{{- $interactive := stdinIsATTY -}}

{{- $isLinux := eq .chezmoi.os "linux" -}}
{{- $isRoot := false -}}

{{- if $isLinux -}}
  {{- $uid := output "id" "-u" | trim | atoi -}}
  {{- if eq $uid 0 -}}
    {{- $isRoot = true -}}
  {{- end -}}
{{- end -}}


{{- $isWindows := eq .chezmoi.os "windows" -}}

{{- $isWSL := and $isLinux (contains "microsoft-standard-WSL" .chezmoi.kernel.osrelease) -}}

{{- $isDocker := or (ne (stat "/.dockerenv") nil) (ne (stat "/.dockerinit") nil) -}}

{{- $isSSH := or (ne (env "SSH_CLIENT") "") (ne (env "SSH_TTY") "") (ne (env "SSH_CONNECTION") "") -}}
{{- $isMOSH := ne (env "MOSH_SSH_CONNECTION") "" -}}

{{- $isCodeSpaces := ne (env "CODESPACES") "" -}}
{{- $isDevContainer := or (ne (env "REMOTE_CONTAINERS") "") (ne (env "DEVCONTAINER") "") -}}

{{- $isRemote := or $isSSH $isMOSH $isCodeSpaces $isDevContainer -}}
{{- $isEphemeral := or $isDocker $isCodeSpaces $isDevContainer -}}

{{- /* ipapi ISO (e.g. CN, HK, US, JP) */ -}}
{{- $country := output "curl" "-s" "--max-time" "2" "https://ipapi.co/country/" | trim -}}
{{- $needMirror := eq $country "CN" -}}

{{/* ------------------------------------------------------------------
     2. Interactive prompts
     All side effects (prompt* / writeToStdout) live in this section.
   ------------------------------------------------------------------ */}}

{{- if $interactive -}}
    {{- writeToStdout "💡 Tip: you can re-enter your name and email with `chezmoi init --data=false`.\n" -}}
{{- end -}}

{{- $isPersonal := or $isCodeSpaces $isDevContainer -}}
{{- if and $interactive (not $isCodeSpaces) (not $isDevContainer) -}}
    {{- $isPersonal = promptBoolOnce . "isPersonal" "Is this a personal computer or a work station" false -}}
{{- end -}}

{{- $needProxy := false -}}
{{- if $interactive -}}
    {{- if $isWindows -}}
        {{- $needProxy = true -}}
    {{- else -}}
        {{- $needProxy = promptBoolOnce . "needProxy" "Should install mihomo" false -}}
    {{- end -}}
{{- end -}}

{{- $mihomoUrl := "" -}}
{{- $mihomoSecret := "" -}}
{{- if $needProxy -}}
    {{- $mihomoUrl = promptStringOnce . "mihomo.url" "Please paste your proxy provider url here(without quotes)" | quote -}}
    {{- if $isRemote -}}
        {{- $mihomoSecret = promptStringOnce . "mihomo.secret" "Please set your external web control secret, empty for default password" | trim | default "mihomo" | quote -}}
        {{- writeToStdout "🎯 Note: you may need to allow tcp 9090 pass firewall using ufw. e.g. `sudo ufw allow from 100.123.126.33 port 9090 proto tcp` or `sudo ufw allow 9090/tcp`.\n" -}}
    {{- end -}}
{{- end -}}

{{- $init := dict "install" true "extras" (list) -}}
{{- if not $isPersonal -}}
    {{- $_ := set $init "install" (promptBoolOnce . "init.install" "Should use install package manager and essential apps?" false) -}}
{{- end -}}
{{- if $init.install -}}
    {{- if $isWindows -}}
        {{- $_ := set $init "extras" (concat $init.extras (list "fonts" "extra")) -}}
    {{- else if $isLinux -}}
        {{- $_ := set $init "extras" (concat $init.extras (list "network" "build" "extra" "shell" "media")) -}}
    {{- end -}}
    {{- $_ := set $init "extras" (promptMultichoice "Select extra packages to install" $init.extras (list "extra")) -}}
{{- end -}}

{{- /* token 始终写出，下游模板才能安全依赖 .token.deepseek */ -}}
{{- $enable := false -}}
{{- $deepseek := "" -}}
{{- with index . "token" -}}
    {{- $enable = index . "enable" | default false -}}
    {{- $deepseek = index . "deepseek" | default "" -}}
{{- end -}}

{{- /* 优先读取环境变量 DEEPSEEK_TOKEN，缺失则回退到已保存的值，最终为空 */ -}}
{{- $deepseek = env "DEEPSEEK_TOKEN" | trim | default $deepseek -}}

{{- if $interactive -}}
    {{- $enable = promptBool "Should add DeepSeek API token" $enable -}}
    {{- if $enable -}}
        {{- $deepseek = promptStringOnce . "token.deepseek" "Please paste your deepseek token here" -}}
    {{- end -}}
{{- end -}}

{{/* ------------------------------------------------------------------
     3. TOML output
     Pure rendering from the values computed above.
   ------------------------------------------------------------------ */}}

sourceDir = "~/.config/.dotfiles"

[data]
    isPersonal = {{ $isPersonal }}
    isRoot = {{ $isRoot }}

    isWSL = {{ $isWSL }}
    isLinux = {{ $isLinux }}
    isWindows = {{ $isWindows }}
    isDocker = {{ $isDocker }}
    isEphemeral = {{ $isEphemeral }}
    isRemote = {{ $isRemote }}

    needMirror = {{ $needMirror }}
    needProxy = {{ $needProxy }}

    {{ if $needProxy }}
        mihomo.url = {{ $mihomoUrl }}
        {{ if $isRemote }}
            mihomo.secret = {{ $mihomoSecret }}
        {{ end }}
    {{ end }}

init.install = {{ $init.install }}
init.extras = {{ $init.extras | toToml }}

token.enable = {{ $enable }}
{{ if $enable }}
token.deepseek = {{ $deepseek | quote }}
{{ end }}

[interpreters.ps1]
    command = """
    {{- if lookPath "pwsh" -}}pwsh
    {{- else if lookPath "powershell.exe" -}}powershell.exe
    {{- end -}}
    """
    args = ["-NoProfile", "-NonInteractive", "-ExecutionPolicy", "Bypass", "-File"]

[cd]
    command = """
    {{- if lookPath "bash" -}}bash
    {{- else if lookPath "fish" -}}fish
    {{- else if lookPath "pwsh" -}}pwsh
    {{- else if lookPath "powershell.exe" -}}powershell.exe
    {{- end -}}
    """
