#!/usr/bin/env python3
"""Launch Claude or Copilot CLI pre-configured for the DeepSeek API.

Usage:
    ds            -> claude, deepseek-v4-pro (default)
    ds f | flash  -> copilot, deepseek-v4-flash
    ds p | pro    -> copilot, deepseek-v4-pro
    ds <name>     -> copilot, use <name> verbatim
    ds --no-tmux  -> never auto-relaunch inside tmux

CLI selection:
    Passing a model argument selects copilot; running `ds` with no model
    argument selects claude. If the preferred CLI is not installed, the other
    one is used instead.

Notes:
    When an SSH session is detected (and tmux is available), the CLI is
    automatically relaunched inside a tmux session so the agent survives
    dropped connections. Set DS_TMUX_SESSION to pick another session name.
"""

import argparse
import os
import shlex
import shutil
import subprocess
import sys
from pathlib import Path

TOKEN_FILE = Path.home() / ".config" / "bash" / "tokenenv.sh"
DEFAULT_MODEL = "deepseek-v4-pro"
DEFAULT_TMUX_SESSION = "ds"
TMUX_MARKER_ENV = "DS_IN_TMUX"
REMOTE_ENV_VARS = ("SSH_CONNECTION", "SSH_CLIENT", "SSH_TTY")

# alias -> concrete model name
MODEL_ALIASES = {
    "f": "deepseek-v4-flash",
    "flash": "deepseek-v4-flash",
    "p": DEFAULT_MODEL,
    "pro": DEFAULT_MODEL,
}


# Token handling
def load_token_from_file() -> str | None:
    """Read DEEPSEEK_TOKEN from the token file, if present."""
    if not TOKEN_FILE.exists():
        return None

    try:
        content = TOKEN_FILE.read_text(encoding="utf-8")
    except OSError:
        return None

    for line in content.splitlines():
        if "DEEPSEEK_TOKEN=" not in line:
            continue
        _, _, value = line.partition("=")
        value = value.strip().strip("'\"")
        if value:
            return value
    return None


def save_token(token: str) -> None:
    """Append the token to the token file, creating parent dirs as needed."""
    TOKEN_FILE.parent.mkdir(parents=True, exist_ok=True)
    with TOKEN_FILE.open("a", encoding="utf-8") as f:
        f.write(f"export DEEPSEEK_TOKEN='{token}'\n")


def prompt_for_token() -> str:
    """Ask the user interactively for a token, then persist it."""
    print("⚠️ Missing DEEPSEEK_TOKEN, please fill before using.")
    try:
        token = input("Input your DeepSeek API Key: ").strip()
    except (KeyboardInterrupt, EOFError):
        print("\n❌ Aborted.")
        sys.exit(1)

    if not token:
        print("❌ API Key is blank, abort.")
        sys.exit(1)

    save_token(token)
    print(f"✅ Token is saved in {TOKEN_FILE}")
    return token


def ensure_token() -> str:
    """Return a usable token: env var > token file > interactive prompt."""
    token = os.environ.get("DEEPSEEK_TOKEN") or load_token_from_file()

    if not token:
        token = prompt_for_token()

    os.environ["DEEPSEEK_TOKEN"] = token
    return token


# Remote / tmux handling
def is_remote_session() -> bool:
    """Return True when the current process looks like it runs over SSH."""
    return any(os.environ.get(var) for var in REMOTE_ENV_VARS)


def inside_tmux() -> bool:
    """Return True when we are already running inside a tmux session."""
    return bool(os.environ.get("TMUX")) or os.environ.get(TMUX_MARKER_ENV) == "1"


def relaunch_in_tmux(args: list[str]) -> int | None:
    """Re-exec this script inside tmux for remote sessions.

    Returns an exit code when the caller should stop, or None when the
    script should keep running in the current terminal.
    """
    if inside_tmux() or not is_remote_session():
        return None

    if not (sys.stdin.isatty() and sys.stdout.isatty()):
        return None

    if shutil.which("tmux") is None:
        print("⚠️ Remote session detected, but tmux is not installed; continuing here.")
        return None

    session = os.environ.get("DS_TMUX_SESSION") or DEFAULT_TMUX_SESSION
    inner = [
        "env",
        f"{TMUX_MARKER_ENV}=1",
        sys.executable,
        str(Path(__file__).resolve()),
        *args,
    ]
    # tmux runs the command string through a shell, so quote every part.
    launch = f"cd {shlex.quote(os.getcwd())} && " + " ".join(
        shlex.quote(part) for part in inner
    )
    # When the pane's process exits, tmux destroys the session and restores the
    # screen it covered, so anything the pane printed is lost and all the user
    # sees is "[exited]". Hold the pane open on failure so the real error is
    # readable. `sh -c` keeps the guard portable regardless of default-shell.
    guard = (
        '; rc=$?; if [ "$rc" -ne 0 ] && [ "$rc" -ne 130 ]; then '
        'printf "\\n[ds] inner process exited with status %s\\n" "$rc"; '
        "printf '[ds] press Enter to close this pane\\n'; "
        "read -r _ || true; fi"
    )
    command = "sh -c " + shlex.quote(launch + guard)

    print(f"🖥️ Remote session detected, opening tmux session '{session}'...")
    try:
        result = subprocess.run(["tmux", "new-session", "-A", "-s", session, command])
    except (FileNotFoundError, KeyboardInterrupt):
        return None

    if result.returncode != 0:
        print("⚠️ Failed to start tmux; falling back to the current terminal.")
        return None
    return 0


# Model / CLI resolution
def resolve_model(arg: str | None) -> str:
    """Map a user-supplied alias to a concrete model name."""
    if not arg:
        return DEFAULT_MODEL
    return MODEL_ALIASES.get(arg.lower(), arg)


def detect_cli(prefer_copilot: bool) -> str | None:
    """Return the CLI to launch, honouring the preference then falling back.

    ``prefer_copilot`` is set when the user passed an explicit model, so
    ``ds`` alone means claude while ``ds f`` means copilot. If the preferred
    command is missing the other one is used instead.
    """
    order = ("copilot", "claude") if prefer_copilot else ("claude", "copilot")
    for name in order:
        if shutil.which(name):
            return name
    return None


# Launchers
def run_agent(cmd: list[str], env: dict[str, str]) -> int:
    """Run the CLI and translate failures into an exit code."""
    try:
        subprocess.run(cmd, env=env, check=True)
    except subprocess.CalledProcessError as e:
        return e.returncode
    except FileNotFoundError:
        print(f"❌ Command not found: {cmd[0]}")
        return 127
    return 0


def launch_claude(token: str, model: str) -> int:
    env = os.environ.copy()
    env.setdefault("ANTHROPIC_BASE_URL", "https://api.deepseek.com/anthropic")
    env["ANTHROPIC_AUTH_TOKEN"] = token

    print(f"🚀 Launching Claude (Model: {model})...")
    return run_agent(["claude", "--model", model], env)


def launch_copilot(token: str, model: str) -> int:
    env = os.environ.copy()
    env["COPILOT_PROVIDER_TYPE"] = "anthropic"
    env["COPILOT_PROVIDER_BASE_URL"] = "https://api.deepseek.com/anthropic"
    env["COPILOT_PROVIDER_API_KEY"] = token
    env["COPILOT_MODEL"] = model

    print(f"🚀 Launching Copilot (Model: {model})...")
    return run_agent(["copilot"], env)


# Entry point
def ensure_utf8_stdio() -> None:
    """Force UTF-8 on stdout/stderr.

    The status messages contain emoji; on a non-UTF-8 locale (Windows console,
    a tmux pane started with LANG unset, ...) ``print`` raises
    UnicodeEncodeError, which would kill the process before it does anything.
    """
    for stream in (sys.stdout, sys.stderr):
        try:
            stream.reconfigure(encoding="utf-8", errors="replace")  # type: ignore[attr-defined]
        except (AttributeError, ValueError, OSError):
            pass


def parse_args() -> argparse.Namespace:
    parser = argparse.ArgumentParser(
        description=(
            "Launch Copilot CLI (when a model is given) or Claude CLI (no model) "
            "with DeepSeek configuration."
        )
    )
    parser.add_argument(
        "model",
        nargs="?",
        default=None,
        help=(
            "Model selection: f/flash, p/pro, or custom model name "
            "(omitting it selects claude with deepseek-v4-pro)"
        ),
    )
    parser.add_argument(
        "--no-tmux",
        action="store_true",
        help="Do not auto-relaunch inside tmux, even over SSH",
    )
    return parser.parse_args()


def main() -> int:
    ensure_utf8_stdio()
    args = parse_args()

    # Resolve the CLI and the token *before* hopping into tmux: a failure here is
    # then reported in the current terminal instead of inside a pane that is torn
    # down before the message can be read.
    # An explicit model argument means copilot; a bare `ds` means claude.
    cli = detect_cli(prefer_copilot=args.model is not None)
    if cli is None:
        print("❌ Error: Neither 'claude' nor 'copilot' command found.")
        print("Please install Copilot using: pnpm install -g @github/copilot")
        return 1

    token = ensure_token()
    model = resolve_model(args.model)

    if not args.no_tmux:
        tmux_exit = relaunch_in_tmux(sys.argv[1:])
        if tmux_exit is not None:
            return tmux_exit

    if cli == "claude":
        return launch_claude(token, model)
    return launch_copilot(token, model)


if __name__ == "__main__":
    sys.exit(main())
