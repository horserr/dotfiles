# syntax=docker/dockerfile:1
FROM mcr.microsoft.com/devcontainers/base:resolute

# 1. Prevent Ubuntu from deleting downloaded packages automatically
RUN rm -f /etc/apt/apt.conf.d/docker-clean; \
  echo 'Binary::apt::APT::Keep-Downloaded-Packages "true";' > /etc/apt/apt.conf.d/keep-cache

# 2. Use BuildKit cache mounts for both the package index and package archives
RUN --mount=type=cache,target=/var/cache/apt,sharing=locked \
  --mount=type=cache,target=/var/lib/apt/lists,sharing=locked \
  apt-get update && \
  apt-get install -y --no-install-recommends \
  file \
  python3 \
  openssh-server \
  build-essential && \
  rm -rf /var/lib/apt/lists/*

# 4. Pre-create the user cache dir *and* the pixi cache mount point, both owned by vscode.
#    `~/.cache` itself must exist with the right owner: chezmoi downloads externals
#    (e.g. .vim/autoload/plug.vim) via `mkdir ~/.cache/chezmoi`, so a root-owned
#    ~/.cache (auto-created by Docker for a mount target, or left over from a stale
#    volume) makes every external fail with "permission denied".
#    Creating it here also makes a freshly created named volume mounted over
#    ~/.cache/rattler inherit vscode ownership instead of root.
RUN install -d -o vscode -g vscode /home/vscode/.cache && \
  install -d -o vscode -g vscode /home/vscode/.cache/rattler

# .ssh must be writable by vscode too (chezmoi applies private_dot_ssh as that user).
RUN install -d -m 700 -o vscode -g vscode /home/vscode/.ssh

RUN install -d -m 755 /var/run/sshd

RUN echo 'root:root' | chpasswd

# sshd config
# due to host network, 22 port cannot bind again
RUN echo "PermitRootLogin yes" > /etc/ssh/sshd_config.d/root_login.conf && \
  echo "PasswordAuthentication yes" >> /etc/ssh/sshd_config.d/root_login.conf && \
  echo "Port 2222" >> /etc/ssh/sshd_config.d/root_login.conf

EXPOSE 2222
